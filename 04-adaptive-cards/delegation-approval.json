{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "Delivery Manager Assignment",
      "weight": "Bolder",
      "size": "Large",
      "color": "Accent"
    },
    {
      "type": "FactSet",
      "facts": [
        { "title": "Customer", "value": "${customerName}" },
        { "title": "Work", "value": "${workSummary}" },
        { "title": "Skills required", "value": "${requiredSkills}" },
        { "title": "Start", "value": "${targetStartDate}" },
        { "title": "Estimate", "value": "${estimatedHours} hrs" }
      ]
    },
    { "type": "TextBlock", "text": "Top 3 candidates (ranked)", "weight": "Bolder", "spacing": "Medium" },
    {
      "type": "Container",
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "1.", "weight": "Bolder" }] },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "${candidates[0].name} — ${candidates[0].role}", "weight": "Bolder" },
                { "type": "TextBlock", "text": "Skills: ${candidates[0].skills}", "size": "Small", "isSubtle": true, "wrap": true },
                { "type": "TextBlock", "text": "Open changes: ${candidates[0].openChanges}  |  Last 3: ${candidates[0].recentWork}", "size": "Small", "wrap": true }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "columns": [
            { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "2." }] },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "${candidates[1].name} — ${candidates[1].role}" },
                { "type": "TextBlock", "text": "Skills: ${candidates[1].skills}", "size": "Small", "isSubtle": true, "wrap": true },
                { "type": "TextBlock", "text": "Open changes: ${candidates[1].openChanges}  |  Last 3: ${candidates[1].recentWork}", "size": "Small", "wrap": true }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet",
          "columns": [
            { "type": "Column", "width": "auto", "items": [{ "type": "TextBlock", "text": "3." }] },
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                { "type": "TextBlock", "text": "${candidates[2].name} — ${candidates[2].role}" },
                { "type": "TextBlock", "text": "Skills: ${candidates[2].skills}", "size": "Small", "isSubtle": true, "wrap": true },
                { "type": "TextBlock", "text": "Open changes: ${candidates[2].openChanges}  |  Last 3: ${candidates[2].recentWork}", "size": "Small", "wrap": true }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Input.ChoiceSet",
      "id": "selectedCandidate",
      "style": "expanded",
      "label": "Assign to",
      "value": "${candidates[0].id}",
      "choices": [
        { "title": "${candidates[0].name} (recommended)", "value": "${candidates[0].id}" },
        { "title": "${candidates[1].name}", "value": "${candidates[1].id}" },
        { "title": "${candidates[2].name}", "value": "${candidates[2].id}" },
        { "title": "Someone else (specify in comments)", "value": "other" }
      ]
    },
    {
      "type": "Input.Text",
      "id": "comments",
      "label": "Comments (or specify alternate assignee)",
      "isMultiline": true
    }
  ],
  "actions": [
    { "type": "Action.Submit", "title": "Approve assignment", "style": "positive", "data": { "verb": "approve" } },
    { "type": "Action.Submit", "title": "Reject", "style": "destructive", "data": { "verb": "reject" } }
  ]
}
